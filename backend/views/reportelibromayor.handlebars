<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <title>LIBRO MAYOR</title>

  <style>
    @page {
      size: A4;
      margin: 20mm;

      @bottom-right {
        content: "Hoja " counter(page) " de " counter(pages);
        font-family: "Arial Narrow", Arial, sans-serif;
        font-size: 8pt;
      }
    }

    body {
      font-family: "Arial Narrow", Arial, sans-serif;
      font-size: 8pt;
      color: #000;
      margin: 0;
      padding: 0;
      position: relative;
    }

    /* ENCABEZADO */
    .encabezado {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #000;
      padding: 10px 20px;
      margin-bottom: 10px;
    }

    .encabezado img {
      height: 50px;
    }

    .encabezado-texto {
      text-align: center;
      flex: 1;
      font-size: 9pt;
      line-height: 1.2;
    }

    .encabezado-texto strong {
      display: block;
      font-size: 11pt;
      margin-bottom: 3px;
    }

    .barra-inferior {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 8pt;
      margin-top: 10px;
      padding: 0 20px;
    }

    h1 {
      text-align: center;
      color: #2c3e50;
      margin-top: 5px;
      margin-bottom: 10px;
      font-size: 13pt;
      text-transform: uppercase;
      position: relative;
      z-index: 2;
    }

    /* INFO DE LA CUENTA */
    .cuenta-info {
      padding: 0 20px;
      margin-bottom: 10px;
      position: relative;
      z-index: 2;
    }

    .cuenta-info h3 {
      margin: 0 0 4px 0;
      font-size: 10pt;
    }

    .cuenta-info .rango {
      font-size: 8pt;
      color: #333;
    }

    /* TABLA DE MOVIMIENTOS */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8pt;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 3px 5px;
      text-align: left;
    }

    th {
      font-size: 9pt;
      text-align: center;
      background-color: #f8f8f8;
    }

    .saldo-inicial td,
    .saldo-final td {
      font-weight: bold;
      background-color: #f8f8f8;
    }

    .sin-movimientos {
      padding: 10px 20px;
      font-style: italic;
      color: #555;
      position: relative;
      z-index: 2;
    }

    /* MARCA DE AGUA */
    .marca-agua {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.15;
      z-index: 0;
      width: 380px;
      pointer-events: none;
    }
  </style>
</head>

<body>
  <!-- Encabezado institucional -->
  <div class="encabezado">
    <img src="{{unc}}" alt="Logo Izquierdo">
    <div class="encabezado-texto">
      <strong>UNIVERSIDAD NACIONAL DE CONCEPCIÓN</strong>
      FACULTAD DE CIENCIAS ECONÓMICAS Y ADMINISTRATIVAS<br>
      CARRERA DE CONTADURÍA PÚBLICA
    </div>
    <img src="{{fcea}}" alt="Logo Derecho">
  </div>

  <div class="barra-inferior">
    <div>
      <h3>Empresa: {{empresa}}</h3>
    </div>
    <div id="fecha-hora"></div>
  </div>

  <h1>LIBRO MAYOR</h1>

  <div class="cuenta-info">
    <h3>{{cuenta.codigo}} — {{cuenta.nombre}} ({{cuenta.naturaleza}})</h3>
    {{#if fecha_desde}}
      {{#if fecha_hasta}}
        <div class="rango">Período: {{fecha_desde}} a {{fecha_hasta}}</div>
      {{else}}
        <div class="rango">Desde: {{fecha_desde}}</div>
      {{/if}}
    {{else}}
      {{#if fecha_hasta}}
      <div class="rango">Hasta: {{fecha_hasta}}</div>
      {{else}}
      <div class="rango">Todo el historial disponible</div>
      {{/if}}
    {{/if}}
  </div>

  {{#if movimientos}}
  <table>
    <thead>
      <tr>
        <th>Fecha</th>
        <th>N° Asiento</th>
        <th>Documento</th>
        <th>Concepto</th>
        <th>Debe (Gs.)</th>
        <th>Haber (Gs.)</th>
        <th>Saldo (Gs.)</th>
      </tr>
    </thead>
    <tbody>
      <tr class="saldo-inicial">
        <td colspan="6" style="text-align:right;">Saldo inicial:</td>
        <td style="text-align:right;">{{saldo_inicial}}</td>
      </tr>
      {{#each movimientos}}
      <tr>
        <td>{{fecha}}</td>
        <td>{{numero_asiento}}</td>
        <td>{{documento}}</td>
        <td>{{concepto}}</td>
        <td style="text-align:right;">{{debe}}</td>
        <td style="text-align:right;">{{haber}}</td>
        <td style="text-align:right;">{{saldo}}</td>
      </tr>
      {{/each}}
      <tr class="saldo-final">
        <td colspan="6" style="text-align:right;">Saldo final:</td>
        <td style="text-align:right;">{{saldo_final}}</td>
      </tr>
    </tbody>
  </table>
  {{else}}
  <p class="sin-movimientos">
    No existen movimientos para la cuenta y período seleccionados.
  </p>
  <table>
    <tbody>
      <tr class="saldo-inicial">
        <td style="text-align:right; width:85%;">Saldo inicial:</td>
        <td style="text-align:right;">{{saldo_inicial}}</td>
      </tr>
      <tr class="saldo-final">
        <td style="text-align:right;">Saldo final:</td>
        <td style="text-align:right;">{{saldo_final}}</td>
      </tr>
    </tbody>
  </table>
  {{/if}}

  <img src="{{marcaAgua}}" class="marca-agua" alt="Marca de agua">

  <script>
    const ahora = new Date();
    const opcionesFecha = { day: '2-digit', month: '2-digit', year: 'numeric' };
    const fecha = ahora.toLocaleDateString('es-PY', opcionesFecha);
    const hora = ahora.toLocaleTimeString('es-PY', { hour: '2-digit', minute: '2-digit' });
    document.getElementById('fecha-hora').innerHTML = `${fecha}<br>${hora}`;
  </script>
</body>

</html>